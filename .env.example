IMAP_HOST=mail.example.com
IMAP_PORT=993
IMAP_TLS=true

SIEVE_HOST=mail.example.com
SIEVE_PORT=4190
SIEVE_SECURITY=starttls

# Name of the sieve script to manage (e.g. "roundcube", "main", "default")
SIEVE_SCRIPT_NAME=roundcube

MAIL_USER=user@example.com
MAIL_PASS=your-password-here

# How often to check for new entries in Graymail/Add (seconds)
POLL_INTERVAL_SECONDS=300

# IMAP folder names (usually no need to change)
GRAYMAIL_FOLDER=Graymail
GRAYMAIL_ADD_FOLDER=Graymail/Add
INBOX_FOLDER=INBOX
